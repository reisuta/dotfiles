f () {
  read data
  cd /Applications/Firefox.app/Contents/MacOS &&  ./firefox -new-tab "https://google.com/search?q=${data}"
  cd 
}

fs () {
  datas=()
  for i in  {1..5}
  do
    read data
    datas+=${data}
  done
  echo $datas

  for j in {1..5}
  do
    cd
    cd /Applications/Firefox.app/Contents/MacOS &&  ./firefox -new-tab "https://google.com/search?q=${datas[j]}"
    cd
  done
}

