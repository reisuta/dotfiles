{{/*
.chezmoiignore: chezmoi が apply 時に無視するファイル/ディレクトリ。
パスは target 側 (ホーム起点) で指定すること。

ターミナル方針:
  - macOS       : kitty
  - Arch native : kitty
  - WSL         : Windows 側の WezTerm を使うので Linux 側には不要
  - Other Linux : kitty (フォールバック)
*/}}

# ============================================================
# リポジトリのメタファイル (target には配置しない)
# ============================================================
README.md
justfile
scripts
Brewfile
archpkgs.txt
archpkgs-gui.txt
archpkgs-aur.txt
aptpkgs.txt
aptpkgs-gui.txt
.gitattributes

# ============================================================
# OS 別の除外
# ============================================================

{{ if eq .chezmoi.os "darwin" -}}
# macOS: redshift / win-clip-copy.sh / i3 系 WM 設定 / .xprofile は不要
.config/redshift.conf
.config/i3
.config/i3status
.config/sway
.config/gammastep
.config/environment.d
.config/rofi
.config/fcitx5
.local/bin/win-clip-copy.sh
.xprofile
{{ end -}}

{{ if eq .chezmoi.os "linux" -}}
{{- $isWsl := .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{- $isArch := eq .chezmoi.osRelease.id "arch" -}}
{{   if $isWsl -}}
# WSL: ターミナル設定は Windows 側で管理、WM/IME/.xprofile も不要
.config/kitty
.config/wezterm
.config/redshift.conf
.config/i3
.config/i3status
.config/sway
.config/gammastep
.config/environment.d
.config/rofi
.config/fcitx5
.xprofile
{{   else if $isArch -}}
# Arch native: kitty / i3 / rofi / fcitx5 / .xprofile を使う
.config/wezterm
.local/bin/win-clip-copy.sh
{{   else -}}
# その他 Linux: kitty をデフォルト採用、i3 系・.xprofile は Arch 専用なので除外
.config/wezterm
.config/i3
.config/i3status
.config/sway
.config/gammastep
.config/environment.d
.config/rofi
.config/fcitx5
.local/bin/win-clip-copy.sh
.xprofile
{{   end -}}
{{ end -}}

{{ if and (ne .chezmoi.os "linux") (ne .chezmoi.os "darwin") -}}
# 想定外 OS: 最低限のシェル・nvim・tmux のみ
.config/kitty
.config/wezterm
.config/redshift.conf
.config/i3
.config/i3status
.config/sway
.config/gammastep
.config/environment.d
.config/rofi
.config/fcitx5
.local/bin/win-clip-copy.sh
.xprofile
{{ end -}}
