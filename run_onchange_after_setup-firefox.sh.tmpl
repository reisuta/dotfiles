#!/bin/bash
# Firefox / Zen の設定をコード化して反映するスクリプト。chezmoi apply 後に実行。
# 下のハッシュが変わると再実行される (= 素材を編集して chezmoi apply で自動反映)。
#
#   user.js        … about:config の値 (再起動で有効)
#   chrome/*.css   … UI 改造 (再起動で有効)
#   policies.json  … 強制ポリシー。/etc/firefox/policies/ へ (Arch native のみ)
#
# プロファイル名はランダム (例 l1bun7gj.default-release) なので symlink は使えず、
# profiles.ini を読んでアクティブなプロファイルを特定し、実体をコピーする。
# 反映には対象ブラウザの再起動が必要。
#
# user.js     hash: {{ include "dot_config/firefox/user.js" | sha256sum }}
# userChrome  hash: {{ include "dot_config/firefox/chrome/userChrome.css" | sha256sum }}
# policies    hash: {{ include "dot_config/firefox/policies.json" | sha256sum }}
# newtab html hash: {{ include "dot_config/firefox/newtab/index.html" | sha256sum }}

set -euo pipefail

SRC="{{ .chezmoi.sourceDir }}/dot_config/firefox"
XDG="${XDG_CONFIG_HOME:-$HOME/.config}"

# profiles.ini からアクティブなプロファイルの相対パスを取得する。
# まず [Install*] の Default= を見る (実際に使われている既定)。無ければ Default=1 のプロファイル。
resolve_profile() {
    local ini="$1"
    awk -F= '
        /^\[Install/{ins=1; next} /^\[/{ins=0}
        ins && $1=="Default"{print $2; found=1; exit}
        END{ if(!found) exit 1 }
    ' "$ini" 2>/dev/null && return 0
    awk -F= '
        /^\[Profile/{p=1; path=""; def=0; next} /^\[/{p=0}
        p && $1=="Path"{path=$2}
        p && $1=="Default" && $2=="1"{def=1}
        def && path!=""{print path; exit}
    ' "$ini"
}

deploy_profile() {
    local base="$1"
    [ -f "$base/profiles.ini" ] || return 0
    local rel prof
    rel="$(resolve_profile "$base/profiles.ini")" || true
    if [ -z "${rel:-}" ]; then
        echo "  プロファイル特定不可、スキップ: $base"
        return 0
    fi
    prof="$base/$rel"
    [ -d "$prof" ] || { echo "  プロファイル不在、スキップ: $prof"; return 0; }
    mkdir -p "$prof/chrome"
    install -m644 "$SRC/user.js" "$prof/user.js"
    install -m644 "$SRC/chrome/userChrome.css" "$prof/chrome/userChrome.css"
    # 自作スタート画面 (three.js) をプロファイルへ配置し、ホームページに設定。
    # プロファイルパスがランダムなので、file:// パスはここで user.js に注入する。
    if [ -f "$SRC/newtab/index.html" ]; then
        rm -rf "$prof/newtab"
        cp -r "$SRC/newtab" "$prof/newtab"
        printf 'user_pref("browser.startup.homepage", "file://%s/newtab/index.html");\n' "$prof" >> "$prof/user.js"
    fi
    echo "  配置: $prof"
}

echo "==> Firefox / Zen のプロファイルへ user.js / userChrome.css を反映"
# Firefox (通常 / XDG / flatpak) と Zen の候補ディレクトリを総当たり
deploy_profile "$HOME/.mozilla/firefox"
deploy_profile "$XDG/mozilla/firefox"
deploy_profile "$HOME/.var/app/org.mozilla.firefox/.mozilla/firefox"
deploy_profile "$HOME/.zen"
deploy_profile "$XDG/zen"
deploy_profile "$HOME/.var/app/io.github.zen_browser.zen/.zen"

{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") (not (.chezmoi.kernel.osrelease | lower | contains "microsoft")) -}}
if command -v firefox >/dev/null 2>&1; then
    echo "==> policies.json を /etc/firefox/policies/ へ反映"
    sudo install -Dm644 "$SRC/policies.json" /etc/firefox/policies/policies.json
fi
{{ else -}}
echo "(policies.json は Arch native のみ。/etc 反映はスキップ)"
{{ end -}}

echo "==> 反映完了。設定は対象ブラウザの再起動後に有効になります。"
